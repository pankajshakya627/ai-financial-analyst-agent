# ============================================================
# AI Financial Analyst Agent — Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# === LLM Provider (choose one) ===
# Options: anthropic, openai, ollama, llamacpp
LLM_PROVIDER=ollama

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- OpenAI (GPT) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Ollama (Local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest

# --- llama.cpp ---
# Server mode (llama-server):
LLAMACPP_BASE_URL=http://localhost:8080
# In-process mode (llama-cpp-python):
# LLAMACPP_MODEL_PATH=/path/to/model.gguf
LLAMACPP_N_CTX=8192
LLAMACPP_N_GPU_LAYERS=-1

# === LLM Parameters ===
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# === Embedding Provider ===
# Options: sentence_transformers, openai, ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest

# === Financial Data APIs (at least one recommended) ===
# Financial Modeling Prep (best free tier)
FMP_API_KEY=

# Alpha Vantage
ALPHA_VANTAGE_API_KEY=

# Finnhub (news + estimates)
FINNHUB_API_KEY=

# Polygon.io
POLYGON_API_KEY=

# === SEC EDGAR (required) ===
SEC_EDGAR_USER_AGENT=FinancialAnalystAgent/1.0 (your-email@example.com)

# === RAG Configuration ===
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=10
SIMILARITY_THRESHOLD=0.3

# === ChromaDB ===
CHROMA_PERSIST_DIR=./data/vector_store

# === Server ===
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
